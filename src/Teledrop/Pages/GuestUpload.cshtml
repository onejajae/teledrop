@page "/u/{path}"
@model Teledrop.Features.UploadTickets.GuestUploadModel
@{
    ViewData["Title"] = "파일 보내기";
}

<section id="guest-upload-card" class="td-section">
    <div class="td-section-body">
        @if (Model.UploadSucceeded)
        {
            <div class="py-5 text-center" role="status">
                <svg class="mx-auto size-12 text-success" aria-hidden="true" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.3-4.1-4.1 1.4-1.4 2.7 2.7 5.6-5.6 1.4 1.4-7 7Z" />
                </svg>
                <h1 class="mt-3 text-2xl font-bold">파일을 받았습니다.</h1>
                <p class="mt-2 truncate font-semibold">@Model.UploadedFileName</p>
                <p class="td-muted text-sm">
                    @Teledrop.Features.Drops.IndexModel.FormatFileSize(
                        Model.UploadedFileSizeBytes)
                </p>
            </div>
        }
        else if (Model.IsUnavailable)
        {
            <div class="td-alert td-alert-warning" role="status">
                <div>
                    <p class="font-semibold">만료된 링크입니다.</p>
                    <p class="mt-1 text-sm">새 Upload Ticket을 요청해 주세요.</p>
                </div>
            </div>
        }
        else
        {
            <div class="td-section-header">
                <div>
                    <h1 class="td-section-title">파일 보내기</h1>
                    <p class="td-section-subtitle">파일 하나를 안전하게 보내세요.</p>
                </div>
            </div>

            @if (Model.TicketCodeError is not null)
            {
                <div class="td-alert td-alert-error mb-4" role="alert">
                    <span>@Model.TicketCodeError</span>
                </div>
            }

            <form id="guest-upload-form"
                  method="post"
                  enctype="multipart/form-data"
                  asp-antiforgery="false"
                  hx-post="@Model.Request.Path"
                  hx-encoding="multipart/form-data"
                  hx-target="#guest-upload-card"
                  hx-select="#guest-upload-card"
                  hx-swap="outerHTML"
                  class="space-y-4">
                @Html.AntiForgeryToken()

                <fieldset class="td-fieldset">
                    <legend class="td-label">Ticket Code</legend>
                    <input type="text"
                           name="TicketCode"
                           class="input w-full font-mono uppercase tracking-widest"
                           inputmode="text"
                           autocomplete="one-time-code"
                           autocapitalize="characters"
                           maxlength="9"
                           placeholder="K7M2-9XPQ"
                           required />
                </fieldset>

                <label id="guest-upload-zone"
                       class="td-upload-zone"
                       for="guest-upload-file">
                    <input id="guest-upload-file"
                           type="file"
                           name="File"
                           required />
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16.5a4.5 4.5 0 0 1-.4-9A6 6 0 0 1 18 9.4a3.6 3.6 0 0 1-.5 7.1M12 21V10m0 0-3 3m3-3 3 3" />
                    </svg>
                    <p id="guest-upload-prompt" class="td-upload-prompt">
                        <strong>클릭하여 업로드</strong> 또는 끌어서 가져오기
                    </p>
                    <p id="guest-upload-filename"
                       class="td-upload-filename"
                       hidden></p>
                    <p id="guest-upload-drop-error"
                       class="text-sm font-semibold text-error"
                       role="alert"
                       hidden></p>
                </label>

                <div id="guest-upload-progress-wrap" hidden>
                    <progress id="guest-upload-progress"
                              class="td-progress"
                              value="0"
                              max="100"></progress>
                    <p id="guest-upload-progress-label"
                       class="td-muted mt-1 text-center text-sm"
                       aria-live="polite">0%</p>
                </div>

                <button id="guest-upload-submit"
                        type="submit"
                        class="btn btn-primary w-full">
                    보내기
                </button>
            </form>
        }
    </div>
</section>

@section Scripts {
    <script nonce="@ViewContext.HttpContext.Items[SecurityHeaders.ContentSecurityPolicyNonceItemKey]">
        (() => {
            const form = document.getElementById("guest-upload-form");
            if (!form) {
                return;
            }

            const fileInput = document.getElementById("guest-upload-file");
            const uploadZone = document.getElementById("guest-upload-zone");
            const prompt = document.getElementById("guest-upload-prompt");
            const fileName = document.getElementById("guest-upload-filename");
            const dropError = document.getElementById("guest-upload-drop-error");
            const progressWrap = document.getElementById("guest-upload-progress-wrap");
            const progress = document.getElementById("guest-upload-progress");
            const progressLabel = document.getElementById("guest-upload-progress-label");
            const submit = document.getElementById("guest-upload-submit");

            const syncSelectedFile = () => {
                const selectedFile = fileInput.files?.[0];
                prompt.hidden = Boolean(selectedFile);
                fileName.hidden = !selectedFile;
                fileName.textContent = selectedFile?.name ?? "";
                submit.disabled = !selectedFile;
            };

            const clearDropError = () => {
                dropError.textContent = "";
                dropError.hidden = true;
            };

            syncSelectedFile();
            fileInput.addEventListener("change", () => {
                clearDropError();
                syncSelectedFile();
            });

            for (const eventName of ["dragenter", "dragover"]) {
                uploadZone.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    uploadZone.classList.add("is-dragging");
                });
            }

            for (const eventName of ["dragleave", "drop"]) {
                uploadZone.addEventListener(eventName, (event) => {
                    event.preventDefault();
                    uploadZone.classList.remove("is-dragging");
                });
            }

            uploadZone.addEventListener("drop", (event) => {
                const droppedFiles = event.dataTransfer?.files;
                if (!droppedFiles?.length) {
                    return;
                }

                if (droppedFiles.length > 1) {
                    fileInput.value = "";
                    syncSelectedFile();
                    dropError.textContent =
                        "파일은 한 번에 하나만 업로드할 수 있습니다.";
                    dropError.hidden = false;
                    return;
                }

                clearDropError();
                fileInput.files = droppedFiles;
                syncSelectedFile();
            });

            form.addEventListener("htmx:beforeRequest", () => {
                progressWrap.hidden = false;
                progress.value = 0;
                progressLabel.textContent = "0%";
                submit.disabled = true;
            });

            form.addEventListener("htmx:xhr:progress", (event) => {
                if (!event.detail.total) {
                    return;
                }

                const percent = Math.min(
                    100,
                    Math.round((event.detail.loaded / event.detail.total) * 100));
                progress.value = percent;
                progressLabel.textContent = `${percent}%`;
            });

            form.addEventListener("htmx:afterRequest", (event) => {
                submit.disabled = false;

                if (!event.detail.successful) {
                    progressLabel.textContent =
                        event.detail.xhr.status === 413
                            ? "파일이 최대 크기를 초과했습니다."
                            : "업로드에 실패했습니다.";
                }
            });
        })();
    </script>
}
