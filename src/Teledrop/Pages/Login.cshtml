@page "/login"
@model Teledrop.Features.Auth.LoginModel
@{
    ViewData["Title"] = "로그인";
}

<section class="td-section w-full">
    <div class="td-section-body p-6">
        <h1 class="text-center text-2xl font-bold">로그인</h1>

        @if (Model.ErrorMessage is not null)
        {
            <div class="td-alert td-alert-error mt-5" role="alert">
                <svg class="mt-0.5 size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 14h-2v-2h2v2Zm0-4h-2V7h2v5Z" />
                </svg>
                <span>@Model.ErrorMessage</span>
            </div>
        }

        <form method="post" class="mt-5 space-y-5">
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="td-fieldset">
                <label asp-for="Username" class="td-label">사용자 ID</label>
                <input asp-for="Username"
                       class="input w-full"
                       placeholder="사용자 ID"
                       autocomplete="username"
                       autofocus
                       required />
            </div>

            <div class="td-fieldset">
                <label asp-for="Password" class="td-label">비밀번호</label>
                <input asp-for="Password"
                       type="password"
                       class="input w-full"
                       placeholder="••••••"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-full">
                로그인
            </button>
        </form>
    </div>
</section>
