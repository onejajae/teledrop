@page "/tickets"
@model Teledrop.Features.UploadTickets.TicketsModel
@{
    ViewData["Title"] = "Upload Ticket";
}

<a asp-page="/Index" class="td-page-link">
    <span aria-hidden="true">←</span>
    내 업로드
</a>

@if (Model.IssuedUploadTicket is not null)
{
    <section class="td-section">
        <div class="td-section-body">
            <div class="td-alert td-alert-success" role="status">
                <svg class="mt-0.5 size-5 shrink-0" aria-hidden="true" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-1.2 14.3-4.1-4.1 1.4-1.4 2.7 2.7 5.6-5.6 1.4 1.4-7 7Z" />
                </svg>
                <div>
                    <p class="font-semibold">Upload Ticket을 발급했습니다.</p>
                    <p class="text-sm">링크와 Ticket Code를 함께 전달하세요.</p>
                </div>
            </div>

            <div class="mt-4 space-y-3">
                <fieldset class="td-fieldset">
                    <legend class="td-label">전체 링크</legend>
                    <input type="text"
                           class="input w-full font-mono text-sm"
                           value="@Model.IssuedUploadTicketUrl"
                           readonly />
                </fieldset>

                <fieldset class="td-fieldset">
                    <legend class="td-label">Ticket Code</legend>
                    <input type="text"
                           class="input w-full font-mono text-lg tracking-widest"
                           value="@Teledrop.Features.UploadTickets.UploadTicketCredentialGenerator.FormatTicketCode(Model.IssuedUploadTicket.Code)"
                           readonly />
                </fieldset>
            </div>
        </div>
    </section>
}

<section class="td-section">
    <div class="td-section-body">
        <div class="td-section-header">
            <div>
                <h1 class="td-section-title">Upload Ticket</h1>
                <p class="td-section-subtitle">
                    게스트가 파일 하나를 보낼 수 있는 링크를 관리합니다.
                </p>
            </div>
            <form method="post" asp-page-handler="Issue">
                <button type="submit" class="btn btn-primary btn-sm">
                    새 티켓 발급
                </button>
            </form>
        </div>

        <div class="td-list">
            @if (Model.UploadTickets.Count == 0)
            {
                <div class="td-empty">
                    아직 발급한 Upload Ticket이 없습니다.
                </div>
            }
            else
            {
                @foreach (var uploadTicket in Model.UploadTickets)
                {
                    var createdAtUtc = DateTime.SpecifyKind(
                        uploadTicket.CreatedAt,
                        DateTimeKind.Utc);
                    var expiresAtUtc = DateTime.SpecifyKind(
                        uploadTicket.ExpiresAtUtc,
                        DateTimeKind.Utc);
                    var status = Model.GetStatusLabel(uploadTicket);

                    <article class="td-ticket-row items-start">
                        <span class="td-file-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path fill="currentColor" d="M7 3h10a2 2 0 0 1 2 2v4a3 3 0 0 0 0 6v4a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-4a3 3 0 0 0 0-6V5a2 2 0 0 1 2-2Zm1 2v2h2V5H8Zm0 4v2h2V9H8Zm0 4v2h2v-2H8Zm0 4v2h2v-2H8Z" />
                            </svg>
                        </span>

                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <a asp-page="/GuestUpload"
                                   asp-route-path="@uploadTicket.Path"
                                   class="td-row-title font-mono uppercase">
                                    @uploadTicket.Path
                                </a>
                                <span class="td-badge">@status</span>
                            </div>
                            <p class="mt-1 font-mono text-sm tracking-wider">
                                @Teledrop.Features.UploadTickets.UploadTicketCredentialGenerator.FormatTicketCode(uploadTicket.Code)
                            </p>
                            <div class="td-row-meta mt-1">
                                <span>발급 @createdAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                                <span aria-hidden="true">•</span>
                                <span>만료 @expiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>

                        @if (Model.CanRevoke(uploadTicket))
                        {
                            <form method="post"
                                  asp-page-handler="Revoke"
                                  asp-route-id="@uploadTicket.Id">
                                <button type="submit"
                                        class="td-row-action td-row-action-danger"
                                        aria-label="@uploadTicket.Path 티켓 폐기"
                                        title="폐기">
                                    <svg aria-hidden="true" viewBox="0 0 24 24">
                                        <path fill="currentColor" d="M8 3h8l1 2h4v2H3V5h4l1-2Zm1 6h2v8H9V9Zm4 0h2v8h-2V9ZM6 9h2v10h8V9h2v10a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9Z" />
                                    </svg>
                                </button>
                            </form>
                        }
                    </article>
                }
            }
        </div>
    </div>
</section>
