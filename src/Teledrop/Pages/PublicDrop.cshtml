@page "/{slug}"
@model Teledrop.Features.Drops.PublicDropModel
@{
    ViewData["Title"] = Model.IsLocked
        ? "잠긴 드롭"
        : Model.Drop?.Title ?? Model.Drop?.FileName ?? "드롭";
}

@if (Model.IsLocked)
{
    <section class="td-section mx-auto w-full max-w-xl">
        <div class="td-section-body p-6">
            <div class="text-center">
                <svg class="mx-auto size-10 td-muted" aria-hidden="true" viewBox="0 0 24 24">
                    <path fill="currentColor" d="M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9h14v-9a2 2 0 0 0-2-2Zm-7-2a2 2 0 0 1 4 0v2h-4V7Zm3 8.7V18h-2v-2.3a2 2 0 1 1 2 0Z" />
                </svg>
                <h1 class="mt-3 text-2xl font-bold">잠긴 드롭</h1>
                <p class="td-muted mt-1 text-sm">
                    드롭 비밀번호를 입력해야 열 수 있습니다.
                </p>
            </div>

            @if (Model.UnlockError is not null)
            {
                <div class="td-alert td-alert-error mt-5" role="alert">
                    <span>@Model.UnlockError</span>
                </div>
            }

            <form method="post"
                  asp-page-handler="Unlock"
                  asp-route-slug="@RouteData.Values["slug"]"
                  class="mt-5 space-y-4">
                <fieldset class="td-fieldset">
                    <legend class="td-label">드롭 비밀번호</legend>
                    <input asp-for="DropPassword"
                           type="password"
                           class="input w-full"
                           placeholder="••••••"
                           autocomplete="current-password"
                           autofocus
                           required />
                </fieldset>
                <button type="submit" class="btn btn-primary w-full">
                    열기
                </button>
            </form>
        </div>
    </section>
}
else if (Model.Drop is { } drop)
{
    var displayTitle = string.IsNullOrEmpty(drop.Title)
        ? drop.FileName
        : drop.Title;
    var formattedSize =
        Teledrop.Features.Drops.IndexModel.FormatFileSize(drop.FileSizeBytes);
    var inlineUrl = Url.Page(
        "/Download",
        pageHandler: null,
        values: new { slug = drop.Slug, inline = true });
    var isImage = drop.ContentType.StartsWith(
        "image/",
        StringComparison.OrdinalIgnoreCase);
    var isVideo = drop.ContentType.StartsWith(
        "video/",
        StringComparison.OrdinalIgnoreCase);
    var isAudio = drop.ContentType.StartsWith(
        "audio/",
        StringComparison.OrdinalIgnoreCase);

    <section class="td-section">
        <div class="td-section-body">
            <div class="td-section-header">
                <div class="min-w-0">
                    <h1 class="td-section-title break-words">@displayTitle</h1>
                    <p class="td-section-subtitle">공유된 파일</p>
                </div>
                <a asp-page="/Download"
                   asp-route-slug="@drop.Slug"
                   class="btn btn-primary btn-sm">
                    <svg class="size-4" aria-hidden="true" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M11 4h2v8.2l2.6-2.6L17 11l-5 5-5-5 1.4-1.4 2.6 2.6V4ZM5 18h14v2H5v-2Z" />
                    </svg>
                    다운로드
                </a>
            </div>

            @if (isImage)
            {
                <div class="td-preview mb-3">
                    <img src="@inlineUrl" alt="@displayTitle" />
                </div>
            }
            else if (isVideo)
            {
                <div class="td-preview mb-3 bg-black">
                    <video src="@inlineUrl" controls preload="metadata"></video>
                </div>
            }
            else if (isAudio)
            {
                <div class="mb-3 rounded-lg border border-base-300 p-4">
                    <audio src="@inlineUrl" controls class="w-full"></audio>
                </div>
            }

            @if (!string.IsNullOrEmpty(drop.Description))
            {
                <p class="mb-4 whitespace-pre-wrap text-sm leading-6">
                    @drop.Description
                </p>
            }

            <div class="flex items-center gap-3 rounded-lg border border-base-300 p-3">
                <span class="td-file-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path fill="currentColor" d="M6 2h8l5 5v15H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm7 2v5h4l-4-5ZM8 13v2h7v-2H8Zm0 4v2h7v-2H8Z" />
                    </svg>
                </span>
                <div class="min-w-0 flex-1">
                    <p class="truncate font-semibold" title="@drop.FileName">
                        @drop.FileName
                    </p>
                    <p class="td-muted text-sm">@formattedSize</p>
                </div>
            </div>
        </div>
    </section>
}
