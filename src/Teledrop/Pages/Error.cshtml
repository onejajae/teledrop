@page
@model ErrorModel
@{
    ViewData["Title"] = "오류";
}

<section class="td-section mx-auto w-full max-w-xl">
    <div class="td-section-body p-6 text-center">
        <svg class="mx-auto size-12 text-error" aria-hidden="true" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 14h-2v-2h2v2Zm0-4h-2V7h2v5Z" />
        </svg>
        <h1 class="mt-3 text-2xl font-bold">요청을 처리하지 못했습니다.</h1>
        <p class="td-muted mt-2 text-sm">
            잠시 후 다시 시도해 주세요.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="td-muted mt-4 text-xs">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }

        <a asp-page="/Index" class="btn btn-primary btn-sm mt-5 min-w-28">
            홈으로
        </a>
    </div>
</section>
