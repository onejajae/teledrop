@page "/login"
@model Teledrop.Features.Auth.LoginModel
@{
    ViewData["Title"] = "로그인";
}

<section class="td-section td-login w-full">
    <div class="td-section-body">
        <h1 class="text-center text-2xl font-bold">로그인</h1>

        <form method="post" class="mt-5 space-y-5">
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="td-fieldset">
                <label asp-for="Username" class="td-label">사용자 ID</label>
                <input asp-for="Username"
                       class="input w-full"
                       placeholder="사용자 ID"
                       autocomplete="username"
                       required />
            </div>

            <div class="td-fieldset">
                <label asp-for="Password" class="td-label">비밀번호</label>
                <input asp-for="Password"
                       type="password"
                       class="input w-full"
                       placeholder="••••••"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary w-full">
                로그인
            </button>
            @if (Model.ErrorMessage is not null)
            {
                <p class="td-login-error" role="alert">@Model.ErrorMessage</p>
            }
        </form>
    </div>
</section>
