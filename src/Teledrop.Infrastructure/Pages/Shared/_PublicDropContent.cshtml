@model Teledrop.Features.Drops.PublicDropModel
<div id="public-drop">
@if (Model.IsLocked)
{
    <section class="td-section">
        <div class="td-section-body">
            <form data-public-unlock hx-post="@Url.Page("/PublicDrop", "Unlock", new { slug = ViewContext.RouteData.Values["slug"] })" hx-target="#public-drop" hx-swap="outerHTML" hx-push-url="false" method="post" asp-page="/PublicDrop" asp-page-handler="Unlock" asp-route-slug="@ViewContext.RouteData.Values["slug"]" class="td-lock-form">
                <h1><label asp-for="DropPassword" td-text="Password.Enter"></label></h1>
                <input aria-invalid="@(Model.UnlockError is not null ? "true" : null)" aria-describedby="@(Model.UnlockError is not null ? "unlock-error" : null)" asp-for="DropPassword" type="password" class="input w-full" td-placeholder="Password" autocomplete="current-password" required />
                @if (Model.UnlockError is not null)
                {
                    <p td-text="Password.Incorrect" id="unlock-error" class="text-sm text-error mb-3" role="alert">@Model.UnlockError</p>
                }
                <p data-public-error class="text-sm text-error" role="alert" hidden></p>
                <button type="submit" class="btn btn-sm btn-outline btn-pill" td-text="Confirm"></button>
            </form>
        </div>
    </section>
}
else if (Model.Drop is { } drop)
{
    <section class="td-section">
        <div class="td-section-body">
            <div class="td-section-header">
                <h1 id="public-drop-heading" tabindex="-1" class="td-section-title truncate" title="@drop.FileName">@drop.FileName</h1>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/DropDetail" asp-route-slug="@drop.Slug" class="td-row-action" td-aria-label="Manage" td-tooltip="Manage">
                        <partial name="_Icon" model='@("PenOutline")' />
                    </a>
                }
            </div>
            <partial name="_DropPreview" model="drop" />
        </div>
    </section>
}

</div>
