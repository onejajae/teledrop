@model Teledrop.Features.Drops.DropDetailModel
@{
    var drop = Model.Drop!;
}
@{ var passwordError = ViewData.ModelState[nameof(Model.NewDropPassword)]?.Errors.Count > 0; }
<dialog id="password-dialog" hx-swap-oob="@(Model.FragmentPart == "password" ? "outerHTML" : null)" class="td-dialog" aria-labelledby="password-title" open="@passwordError">
    <div class="td-dialog-header">
        <h2 id="password-title">비밀번호 설정</h2>
        <button type="button" class="td-row-action" data-dialog-close aria-label="닫기"><partial name="_Icon" model='@("CloseOutline")' /></button>
    </div>
    <div class="td-dialog-body">
        <p data-operation-error="password" class="text-sm text-error" role="alert" hidden></p>
        <form method="post" asp-page="/DropDetail" asp-page-handler="Password" hx-post="@Url.Page("/DropDetail", "Password", new { slug = drop.Slug })" hx-swap="none" data-drop-action="password" asp-route-slug="@drop.Slug" id="password-form">
            <div class="td-fieldset">
                <label asp-for="NewDropPassword" class="td-label">새 비밀번호</label>
                <input asp-for="NewDropPassword" type="password" class="input w-full" autocomplete="new-password" placeholder="•••••" required />
                <span asp-validation-for="NewDropPassword" class="text-sm text-error"></span>
            </div>
            <div class="td-fieldset">
                <label for="password-confirm" class="td-label">비밀번호 확인</label>
                <input id="password-confirm" data-password-confirm type="password" class="input w-full" autocomplete="new-password" placeholder="•••••" required />
            </div>
            <button type="submit" class="btn btn-primary w-full">@(drop.DropPasswordHash is null ? "설정" : "변경")</button>
        </form>
        @if (drop.DropPasswordHash is not null)
        {
            <form method="post" asp-page="/DropDetail" asp-page-handler="ClearPassword" hx-post="@Url.Page("/DropDetail", "ClearPassword", new { slug = drop.Slug })" hx-swap="none" data-drop-action="password" asp-route-slug="@drop.Slug" class="mt-4">
                <button type="submit" class="btn w-full">비밀번호 해제</button>
            </form>
        }
    </div>
</dialog>
