@model Teledrop.Features.Drops.DropDetailModel
@{
    var drop = Model.Drop!;
    var passwordError = ViewData.ModelState[nameof(Model.NewDropPassword)]?.Errors.Count > 0;
    // 비밀번호는 공개 상태에만 있으므로, 비밀번호를 정하는 것은 곧 비밀번호로 공개하는 것이다.
    var title = drop.DropPasswordHash is null ? "Password.Publish" : "Password.Change";
}
<dialog id="password-dialog" hx-swap-oob="@(Model.FragmentPart == "access" ? "outerHTML" : null)" class="td-dialog" aria-labelledby="password-title" open="@passwordError">
    <div class="td-dialog-header">
        <h2 id="password-title" td-text="@title"></h2>
        <button type="button" class="td-row-action" data-dialog-close td-aria-label="Close"><partial name="_Icon" model='@("CloseOutline")' /></button>
    </div>
    <div class="td-dialog-body">
        <p data-operation-error="access" class="text-sm text-error" role="alert" hidden></p>
        <form method="post" asp-page="/DropDetail" asp-page-handler="Access" hx-post="@Url.Page("/DropDetail", "Access", new { slug = drop.Slug })" hx-swap="none" data-drop-action="access" asp-route-slug="@drop.Slug" id="password-form">
            <input type="hidden" name="Access" value="password" />
            <div class="td-fieldset">
                <label asp-for="NewDropPassword" class="td-label" td-text="Password.New"></label>
                <input aria-invalid="@(passwordError ? "true" : null)" aria-describedby="password-error" asp-for="NewDropPassword" type="password" class="input w-full" data-dialog-focus autocomplete="new-password" td-placeholder="Password.New" required />
                <span td-text="@Model.PasswordErrorKey" id="password-error" asp-validation-for="NewDropPassword" class="text-sm text-error"></span>
            </div>
            <div class="td-fieldset">
                <label for="password-confirm" class="td-label" td-text="Password.Confirm"></label>
                <input id="password-confirm" data-password-confirm type="password" class="input w-full" autocomplete="new-password" td-placeholder="Password.Confirm" required />
            </div>
            <button type="submit" class="btn btn-primary w-full" td-text="@title"></button>
        </form>
    </div>
</dialog>
