@model Teledrop.Features.Drops.DropDetailModel
@{
    var drop = Model.Drop!;
}
<button id="password-open" type="button" class="td-row-action" data-dialog-open="password-dialog"
        hx-swap-oob="@(Model.FragmentPart == "password" ? "outerHTML" : null)"
        data-tooltip="비밀번호 설정" aria-label="비밀번호 설정">
    <partial name="_Icon" model='@(drop.DropPasswordHash is null ? "LockOpenSolid" : "LockSolid")' />
</button>
