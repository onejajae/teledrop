{
  "name": "teledrop-ui",
  "private": true,
  "description": "Tailwind + daisyUI 빌드와 프런트엔드 vendor 자산. 설치하면 htmx·PDF.js를 wwwroot/js에, Pretendard를 wwwroot/fonts에 복사한다 — ../../docs/DESIGN.md '개발 명령' 참고",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "build": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --minify",
    "watch": "tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.4",
    "htmx.org": "^4.0.0",
    "pdfjs-dist": "^6.3.289",
    "pretendard": "^1.3.9",
    "tailwindcss": "^4.3.3"
  }
}
