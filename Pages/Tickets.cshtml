@page "/tickets"
@model Teledrop.Features.UploadTickets.TicketsModel
@{
    ViewData["Title"] = "Upload Ticket";
}

<div class="min-h-screen bg-base-200 px-4 py-10">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
        <header class="flex flex-wrap items-center justify-between gap-4">
            <div>
                <h1 class="text-4xl font-bold">Upload Ticket</h1>
                <p class="mt-1 text-base-content/70">
                    게스트가 파일 하나를 보낼 수 있는 경로와 코드를 관리합니다.
                </p>
            </div>
            <a asp-page="/Index" class="btn btn-ghost">홈으로</a>
        </header>

        @if (Model.IssuedUploadTicket is not null)
        {
            <section class="card bg-base-100 shadow-xl">
                <div class="card-body">
                    <h2 class="card-title text-2xl">발급했습니다</h2>
                    <p class="text-sm text-base-content/60">
                        링크와 Ticket Code를 함께 전달하세요.
                    </p>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">전체 링크</legend>
                        <input type="text"
                               class="input w-full font-mono"
                               value="@Model.IssuedUploadTicketUrl"
                               readonly />
                    </fieldset>

                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">Ticket Code</legend>
                        <input type="text"
                               class="input w-full font-mono tracking-widest"
                               value="@Teledrop.Features.UploadTickets.UploadTicketCredentialGenerator.FormatTicketCode(Model.IssuedUploadTicket.Code)"
                               readonly />
                    </fieldset>
                </div>
            </section>
        }

        <section class="card bg-base-100 shadow-xl">
            <div class="card-body">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <h2 class="card-title text-2xl">티켓 목록</h2>
                        <p class="mt-1 text-sm text-base-content/60">
                            Ticket Code는 이 화면에서 다시 확인할 수 있습니다.
                        </p>
                    </div>

                    <form method="post" asp-page-handler="Issue">
                        <button type="submit" class="btn btn-primary">
                            새 티켓 발급
                        </button>
                    </form>
                </div>

                <div class="overflow-x-auto">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Ticket Path</th>
                                <th>Ticket Code</th>
                                <th>발급시각</th>
                                <th>만료시각</th>
                                <th>상태</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UploadTickets.Count == 0)
                            {
                                <tr>
                                    <td colspan="6"
                                        class="py-12 text-center text-base-content/60">
                                        아직 발급한 Upload Ticket이 없습니다.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var uploadTicket in Model.UploadTickets)
                                {
                                    var createdAtUtc =
                                        DateTime.SpecifyKind(
                                            uploadTicket.CreatedAt,
                                            DateTimeKind.Utc);
                                    var expiresAtUtc =
                                        DateTime.SpecifyKind(
                                            uploadTicket.ExpiresAtUtc,
                                            DateTimeKind.Utc);
                                    var status =
                                        Model.GetStatusLabel(uploadTicket);

                                    <tr>
                                        <td>
                                            <a asp-page="/GuestUpload"
                                               asp-route-path="@uploadTicket.Path"
                                               class="link link-hover font-mono uppercase">
                                                @uploadTicket.Path
                                            </a>
                                        </td>
                                        <td class="font-mono tracking-wider">
                                            @Teledrop.Features.UploadTickets.UploadTicketCredentialGenerator.FormatTicketCode(uploadTicket.Code)
                                        </td>
                                        <td class="whitespace-nowrap">
                                            <time datetime="@createdAtUtc.ToString("O")"
                                                  title="@createdAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">
                                                @createdAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                            </time>
                                        </td>
                                        <td class="whitespace-nowrap">
                                            <time datetime="@expiresAtUtc.ToString("O")"
                                                  title="@expiresAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")">
                                                @expiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                            </time>
                                        </td>
                                        <td>
                                            <span class="badge badge-outline">
                                                @status
                                            </span>
                                        </td>
                                        <td class="text-right">
                                            @if (Model.CanRevoke(uploadTicket))
                                            {
                                                <form method="post"
                                                      asp-page-handler="Revoke"
                                                      asp-route-id="@uploadTicket.Id">
                                                    <button type="submit"
                                                            class="btn btn-error btn-sm">
                                                        폐기
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>
</div>
